# Copy to .env and edit. Every value below has a working default,
# so the gateway runs with no external services and no API keys.
#
#   cp .env.example .env

# --- Storage -----------------------------------------------------------------
# Defaults to a local SQLite file. Docker Compose overrides this with Postgres.
# DATABASE_URL=postgresql+psycopg://llmops:llmops@localhost:5432/llmops

# Spend counters use an in-memory dict when this is unset, which is fine for a
# single process. Set it to use Redis so counters survive restarts and stay
# correct across multiple workers.
# REDIS_URL=redis://localhost:6379/0

# --- Providers ---------------------------------------------------------------
# All optional. The mock provider needs no keys and is what the tests and the
# workload simulation use, so the demo costs nothing to run.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Which provider to use when a model has no configured credentials: "mock"
# keeps everything offline. Set to "" to make missing credentials a hard error.
DEFAULT_PROVIDER=mock

# --- Behaviour ---------------------------------------------------------------
# Warn once a team passes this fraction of its budget; block at 1.0.
BUDGET_WARN_THRESHOLD=0.8

# Fraction of cheap-model responses re-run on the strongest model and scored,
# which is what turns the savings number into a defensible claim.
#
# Keep this low. A verification call costs roughly 25x the tier-1 request it
# checks, so 10% sampling would spend more on measuring the saving than the
# saving is worth. See the note in app/settings.py for the arithmetic.
SHADOW_SAMPLE_RATE=0.02

# Rerun high-priority requests on a stronger model before answering.
ESCALATE_ON_HIGH_PRIORITY=true

# Per-provider HTTP timeout, in seconds.
REQUEST_TIMEOUT_SECONDS=30
